rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Transaction Data Validation
    function isValidTransaction(data) {
      return data.userId is string &&
        data.userId == request.auth.uid &&
        data.type is string &&
        (data.type == 'income' || data.type == 'expense') &&
        data.category is string &&
        data.category.size() > 0 &&
        data.category.size() <= 200 &&
        data.amount is number &&
        data.amount > 0 &&
        data.date is string &&
        data.date.size() == 10 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.userId is string &&
        data.userId == request.auth.uid &&
        data.businessName is string &&
        data.businessName.size() > 0 &&
        data.businessName.size() <= 100 &&
        data.ownerName is string &&
        data.ownerName.size() > 0 &&
        data.ownerName.size() <= 100 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 255)) &&
        (!('initialCash' in data) || (data.initialCash is number));
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Collection: transactions
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
        isValidId(transactionId) &&
        isValidTransaction(incoming()) &&
        incoming().keys().hasAll(['userId', 'type', 'category', 'amount', 'date']) &&
        incoming().keys().hasOnly(['userId', 'type', 'category', 'amount', 'notes', 'date', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
        isValidId(transactionId) &&
        existing().userId == request.auth.uid &&
        isValidTransaction(incoming()) &&
        incoming().userId == existing().userId &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['type', 'category', 'amount', 'notes', 'date', 'updatedAt']);

      allow delete: if isSignedIn() &&
        isValidId(transactionId) &&
        existing().userId == request.auth.uid;
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().keys().hasAll(['userId', 'businessName', 'ownerName']) &&
        incoming().keys().hasOnly(['userId', 'businessName', 'ownerName', 'phone', 'address', 'initialCash', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        existing().userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'ownerName', 'phone', 'address', 'initialCash', 'updatedAt']);

      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId;
    }
  }
}
