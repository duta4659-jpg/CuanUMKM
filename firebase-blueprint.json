{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan transaksi keuangan pemasukan atau pengeluaran warung/UMKM",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID pemilik data transaksi"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Tipe transaksi: income (pemasukan) atau expense (pengeluaran)"
        },
        "category": {
          "type": "string",
          "maxLength": 200,
          "description": "Kategori transaksi (dapat berupa multi-kategori seperti Penjualan Tunai, Transfer/QRIS)"
        },
        "amount": {
          "type": "number",
          "description": "Nominal transaksi dalam Rupiah (bilangan positif)"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Catatan atau keterangan transaksi"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Tanggal transaksi dalam format YYYY-MM-DD"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan record transaksi"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan record transaksi"
        }
      },
      "required": ["userId", "type", "category", "amount", "date", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil usaha warung / UMKM pengguna",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID pemilik usaha"
        },
        "businessName": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama warung / usaha"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama pemilik usaha"
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "description": "Nomor telepon / WhatsApp"
        },
        "address": {
          "type": "string",
          "maxLength": 255,
          "description": "Alamat warung atau lokasi toko"
        },
        "initialCash": {
          "type": "number",
          "description": "Saldo kas awal warung"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan profil"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan profil"
        }
      },
      "required": ["userId", "businessName", "ownerName"]
    }
  },
  "firestore": {
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "Transaction"
      },
      "description": "Koleksi catatan transaksi keuangan pemasukan dan pengeluaran UMKM"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "UserProfile"
      },
      "description": "Koleksi profil bisnis pemilik UMKM"
    }
  }
}
